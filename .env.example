# Copy to .env and edit. Only RP_ID and ORIGIN matter for most setups.

# Hostname passkeys are bound to, and the full URL the app is served from.
# Changing RP_ID later invalidates every passkey already created.
RP_ID=localhost
ORIGIN=http://localhost:8080

# Host port for the web UI.
WEB_PORT=8080

# Name shown in the passkey prompt.
RP_NAME=Lift Book

# Optional: user ids that get the admin dashboard (comma-separated).
#ADMIN_UIDS=

# Optional: require an invite code to create a profile.
#INVITE_ONLY=1

# Optional extras, off unless set:
#TRAINER_KEY=            # bearer key for the trainer-thread and health-summary routes
#SPOTIFY_CLIENT_ID=      # "now playing" on the watch screen
#SPOTIFY_CLIENT_SECRET=
#SPOTIFY_REFRESH_TOKEN=

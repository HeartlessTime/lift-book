# Build-time configuration for the native (iOS) build. Copy to .env.local and fill in.
# .env.local is gitignored — the real device token must never be committed.
#
#   cp .env.local.example .env.local   &&   npm run sync:ios
#
# Browser builds need none of this: they leave everything unset and stay same-origin.

# Where the API lives, as seen from the phone. The native app serves its own bundle from
# capacitor://localhost, so relative /api/... paths would go nowhere — this is prefixed onto
# every request. No trailing slash. Must be https (WKWebView refuses cleartext).
VITE_API_BASE=https://your-server.example.net:8443

# Long-lived device token, minted on the server with `node scripts/device-token.js`. WKWebView
# can't run WebAuthn, so this is how the app signs in: it is sent as `Authorization: Bearer …`
# on every request. Treat it as a password — anyone holding it is that profile.
VITE_DEVICE_TOKEN=

# Exercise images/animations. Optional: left unset they resolve against VITE_API_BASE
# (<server>/img/, <server>/gif/). Set them to pull the media off a CDN instead.
#VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/images/
#VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/hasaneyldrm/exercises-dataset@7455efae41b330c265e7cd4b78dfa848e7ce5ebd/videos/
